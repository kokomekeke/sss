# Sisi/GNSSLib/cmake/GNSSLibConfig.cmake.in
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads)

# GNSSLib exports OpenMP::OpenMP_CXX as a public dependency when it was built with OpenMP
set(GNSSLIB_HAS_OPENMP "@OpenMP_CXX_FOUND@")
if(GNSSLIB_HAS_OPENMP)
    find_dependency(OpenMP)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/GNSSLibTargets.cmake")

check_required_components(GNSSLib)